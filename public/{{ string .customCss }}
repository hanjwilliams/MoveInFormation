.stage {
  display: block;
  position: absolute;
  top: 0;
  z-index: -10;
  min-height: 40rem;
  width: 100%;
}

header {
  display: block;
  position: relative;
  padding: 2rem;
  margin: 25rem 0 0;
  background-color: white;
  clip-path: polygon(0% 30%, 100% 0%, 100% 100%, 0% 100%);
}

h1 {
  font-family: "Franklin Gothic Medium", "Arial Narrow", Arial, sans-serif;
}

a {
  color: black;
}

@media screen and (min-width: 600px) {
  ul {
    justify-content: end;
  }
  li {
    font-family: "Franklin Gothic Medium", "Arial Narrow", Arial, sans-serif;
    font-size: 1.2rem;
  }
}

