body{padding:0;margin:0;display:block}.parallax{display:block;padding:0;height:100vh;overflow-x:hidden;overflow-y:auto;perspective:2px;transform-style:preserve-3d;perspective-origin:center}.parallax-menu{display:flex;padding:0 2rem;justify-content:center;position:absolute;z-index:1000;top:0;width:100%}.svg-menu{display:flex;padding:0 2rem;justify-content:center;position:absolute;z-index:1000;top:0;width:100%}.parallax-header{display:block;position:relative;z-index:100;top:0;width:100%;height:150px}.svg-header{display:block;position:relative;z-index:100;top:0;width:100%;height:350px}header{position:sticky;z-index:9999;top:0;margin:0;width:100%;height:100px;padding:0;max-width:100%}.site-logo{display:block;margin-right:1rem;margin-top:1rem;width:100px;filter:drop-shadow(0px 3px 2px rgba(50, 50, 0, 0.3))}.site-logo img{width:100%}.parallax-group{display:block;padding:0;margin:0;position:relative;height:700px;transform-style:preserve-3d}.svg-slider{display:block;margin:0;padding:0;width:105%;height:600px;position:relative;transform-style:preserve-3d}.image-slider{height:700px;transform:translateY(-300px) translateZ(-5px) scale(3.5)}.svg-slider-4{transform:translateY(-200px) translateZ(-4px) scale(3)}.svg-slider-3{transform:translateY(-800px) translateZ(-3px) scale(2.5)}.svg-slider-2{transform:translateY(-1700px) translateZ(-2px) scale(2)}.svg-slider-1{transform:translateY(-2300px) translateZ(0) scale(1)}.container{background-color:#303b47;max-width:100%;margin-top:-2px;transform:translateZ(0) scale(1)}.content{background-color:#303b47}footer{background-color:#303b47}