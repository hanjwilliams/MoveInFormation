body{padding:0;margin:0;display:block}.parallax{display:block;padding:0;height:100vh;overflow-x:hidden;overflow-y:auto;perspective:2px;transform-style:preserve-3d;perspective-origin:center}.svg-menu{display:flex;padding:0 1rem .5rem;justify-content:left;align-items:start;position:relative;z-index:1000;top:0;width:100%;background-color:#303b47;transition:background-color .3s ease}header{position:sticky;z-index:9999;top:0;margin:0;width:100%;padding:0;max-width:100%}.site-logo{display:block;flex:0 0 auto;position:relative;margin-right:1rem;bottom:0;width:100px;height:80px;filter:drop-shadow(0px 3px 2px rgba(50, 50, 0, 0.3))}.site-logo img{position:absolute;bottom:0;right:0;width:100px;transition:width .3s ease}@media screen and (min-width: 1199px){.svg-menu{justify-content:center;align-items:start;background-color:#303b47}.site-logo img{width:200px}}#mif-menu.logo-shrink{justify-content:center;align-items:start;background-color:#1f272e}#mif-menu.logo-shrink .site-logo img{top:0;right:0;width:100px}.parallax-group{display:block;padding:0;margin:0;position:relative;height:500px;transform-style:preserve-3d}.svg-slider{display:block;margin:0;padding:0;width:105%;height:600px;overflow:visible;position:relative;transform-style:preserve-3d}.image-slider{transform:translateY(-40vh) translateZ(-5px) scale(3.5)}.svg-slider-4{transform:translateY(0px) translateZ(-4px) scale(3)}.svg-slider-3{transform:translateY(-600px) translateZ(-3px) scale(2.5)}.svg-slider-2{transform:translateY(-1500px) translateZ(-2px) scale(2)}.svg-slider-1{width:100%;position:absolute;bottom:0;margin:-0.1rem}.svg-slider-1 img{position:absolute;bottom:0}.svg-slider-all{position:absolute;bottom:0;transform:translateZ(-2px) scale(2)}.svg-slider-all img{position:absolute;bottom:0}.container{background-color:#303b47;max-width:100%;margin-top:-2px;transform:translateZ(0) scale(1)}.content{background-color:#303b47}