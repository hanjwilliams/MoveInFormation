body {
  padding: 0;
  margin: 0;
  display: block;
}

.parallax {
  display: block;
  padding: 0;
  height: 100vh;
  overflow-x: hidden;
  overflow-y: auto;
  perspective: 2px; /* <-- This line */
  transform-style: preserve-3d;
  perspective-origin: center;
}

.svg-menu {
  display: flex;
  padding: 0 1rem 0.5rem;
  justify-content: left;
  align-items: start;
  position: relative;
  z-index: 1000;
  top: 0;
  width: 100%;
  background-color: rgb(48, 59, 71);
  transition: background-color 0.3s ease;
}

header {
  position: sticky;
  z-index: 9999;
  top: 0;
  margin: 0;
  width: 100%;
  padding: 0;
  max-width: 100%;
}

.site-logo {
  display: block;
  flex: 0 0 auto;
  position: relative;
  margin-right: 1rem;
  bottom: 0;
  width: 100px;
  height: 80px;
  filter: drop-shadow(0px 3px 2px rgba(50, 50, 0, 0.3));
}
.site-logo img {
  position: relative;
  width: 100px;
  transition: width 0.3s ease;
}

@media screen and (min-width: 1199px) {
  .svg-menu {
    justify-content: center;
    align-items: start;
    background-color: rgb(48, 59, 71);
  }
  .site-logo img {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 200px;
  }
}
#mif-menu.logo-shrink {
  justify-content: center;
  align-items: start;
  background-color: rgb(31, 39, 46);
}
#mif-menu.logo-shrink .site-logo img {
  position: relative;
  width: 100px;
}

.parallax-group {
  display: block;
  padding: 0;
  margin: 0;
  position: relative;
  height: 700px;
  transform-style: preserve-3d;
}

.svg-slider {
  display: block;
  margin: 0;
  padding: 0;
  width: 105%;
  height: 600px;
  position: relative;
  transform-style: preserve-3d;
}

.image-slider {
  height: 700px;
  transform: translateY(-300px) translateZ(-5px) scale(3.5);
}

.svg-slider-4 {
  transform: translateY(-200px) translateZ(-4px) scale(3);
}

.svg-slider-3 {
  transform: translateY(-800px) translateZ(-3px) scale(2.5);
}

.svg-slider-2 {
  transform: translateY(-1700px) translateZ(-2px) scale(2);
}

.svg-slider-1 {
  transform: translateY(-2300px) translateZ(0) scale(1);
}

.container {
  background-color: rgb(48, 59, 71);
  max-width: 100%;
  margin-top: -2px;
  transform: translateZ(0) scale(1);
}

.content {
  background-color: rgb(48, 59, 71);
}

footer {
  background-color: rgb(48, 59, 71);
}

/*# sourceMappingURL=parallaxU.css.map */