body {
  padding: 0;
  display: block;
}

.parallax {
  display: block;
  padding: 0;
  height: 100vh;
  overflow-x: hidden;
  overflow-y: auto;
  perspective: 2px; /* <-- This line */
  transform-style: preserve-3d;
  perspective-origin: center;
}

.parallax-menu {
  display: flex;
  padding: 0 2rem;
  justify-content: center;
  position: absolute;
  z-index: 1000;
  top: 0;
  width: 100%;
}

.svg-menu {
  display: flex;
  padding: 0 2rem;
  justify-content: center;
  position: absolute;
  z-index: 1000;
  top: 0;
  width: 100%;
}

.parallax-header {
  display: block;
  position: relative;
  z-index: 100;
  top: 0;
  width: 100%;
  height: 150px;
}

.svg-header {
  display: block;
  position: relative;
  z-index: 100;
  top: 0;
  width: 100%;
  height: 350px;
}

header {
  position: sticky;
  z-index: 9999;
  top: 0;
  margin: 0;
  width: 100%;
  height: 100px;
  padding: 0;
  max-width: 100%;
}

.site-logo {
  display: block;
  margin-right: 1rem;
  margin-top: 1rem;
  width: 100px;
  filter: drop-shadow(0px 3px 2px rgba(50, 50, 0, 0.3));
}
.site-logo img {
  width: 100%;
}

.parallax-group {
  display: block;
  padding: 0;
  position: relative;
  height: 700px;
  transform-style: preserve-3d;
}

.svg-slider {
  display: block;
  margin: 0;
  position: relative;
  transform-style: preserve-3d;
}

.image-slider {
  background: center/cover no-repeat url("/img/bird2.jpg");
  height: 600px;
  transform: translateZ(-5px) scale(6);
}

.svg-slider-4 {
  height: 200px;
  transform: translateY(-200px) translateZ(-4px) scale(6);
}

.svg-slider-3 {
  height: 200px;
  transform: translateY(-500px) translateZ(-3px) scale(5);
}

.svg-slider-2 {
  height: 200px;
  transform: translateY(-300px) translateZ(-2px) scale(3);
}

.svg-slider-1 {
  height: 350px;
  transform: translateY(-800px) translateZ(0) scale(1);
}

.container {
  background-color: rgb(48, 59, 71);
  max-width: 100%;
  transform: translateZ(0) scale(1);
}

.content {
  background-color: rgb(48, 59, 71);
}

footer {
  background-color: rgb(48, 59, 71);
}

/*# sourceMappingURL=parallaxU.css.map */