body {
  color: #222;
  font-size: 1rem;
  font-family: sans-serif;
  line-height: 1.5;
  margin: 1rem;
}

header {
  width: 80rem;
  margin: 0 auto;
  border-bottom: 1px solid #222;
  margin-bottom: 1rem;
}

.container {
  width: 80rem;
  margin: 0 auto;
  display: flex;
}

main {
  flex: 1 1 auto;
}

aside {
  flex: 1 1 0px;
}

footer {
  width: 80rem;
  margin: 0 auto;
  border-top: 1px solid #222;
  margin-top: 1rem;
}

a {
  color: #00e;
  text-decoration: none;
}

.intro-text {
  font-size: 1.6rem;
}

.sidebar {
  width: 20rem;
}

.people-section {
  clear: both;
  width: 100%;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-gap: 2px;
}

.people-item {
  clear: both;
}

.people-info {
  width: 100%;
  margin: 0;
  padding: 2rem;
}

.person-box {
  float: left;
  max-width: 300px;
  margin: 0 1rem 1rem 0;
}

.group-leader {
  background-color: pink;
}

.phd-candidate {
  background-color: teal;
}

.research-assistant {
  background-color: seagreen;
}

.student-hiwi {
  background-color: darkorchid;
}

.collaborator {
  background-color: goldenrod;
}

.alumnus {
  background-color: cornflowerblue;
}

.people-headshot {
  margin: 0;
  padding: 0;
  overflow: hidden;
}
.people-headshot img {
  padding: 0;
  margin: 0;
  width: 100%;
  height: 300px;
  object-fit: cover;
}

.person-headshot {
  margin: 0;
}
.person-headshot img {
  width: 100%;
  margin: 0;
}

.icon-item {
  clear: both;
  min-height: 70px;
}

.icon-image {
  float: left;
  width: 70px;
  margin: 0 1rem 0 0;
}
.icon-image img {
  width: 100%;
  margin: 0;
}

/*# sourceMappingURL=main.css.map */