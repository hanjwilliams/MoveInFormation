body {
  color: #222;
  font-family: sans-serif;
  line-height: 1.5;
  margin: 1rem;
}

header {
  width: 60rem;
  margin: 0 auto;
  border-bottom: 1px solid #222;
  margin-bottom: 1rem;
}

main {
  width: 60rem;
  margin: 0 auto;
}

footer {
  width: 60rem;
  margin: 0 auto;
  border-top: 1px solid #222;
  margin-top: 1rem;
}

a {
  color: #00e;
  text-decoration: none;
}

