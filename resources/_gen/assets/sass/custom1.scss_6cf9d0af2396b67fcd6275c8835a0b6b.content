.stage {
  display: block;
  position: absolute;
  top: 0;
  z-index: -10;
  min-height: 40rem;
  width: 100%;
}

header {
  padding: 2rem 0;
  margin: 25rem auto 0;
  clip-path: polygon(0% 0%, 100% 30%, 100% 100%, 0% 100%);
}

h1 {
  font-family: "Franklin Gothic Medium", "Arial Narrow", Arial, sans-serif;
}

a {
  color: black;
}

@media screen and (min-width: 600px) {
  ul {
    justify-content: end;
  }
  li {
    font-family: "Franklin Gothic Medium", "Arial Narrow", Arial, sans-serif;
    font-size: 1.2rem;
  }
}

